# Copy to .env and adjust. Never commit .env — it is git-ignored.
APP_ENV=dev

# name:role:token[:projectA|projectB]  — roles: admin | engineer | viewer. Tokens must be >= 12 chars.
# Replace these placeholders; the server refuses placeholder tokens when APP_ENV=prod.
API_TOKENS=admin:admin:change-me-admin-token,dev:engineer:change-me-engineer-token,auditor:viewer:change-me-viewer-token

# Defaults to SQLite at ./data/skyforge.db. For PostgreSQL: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local LLM (advisory only). Verify the model with `ollama list`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
LLM_ENABLED=true

# Repository access
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
MAX_REPO_MB=300

# Push fix branches / open draft PRs (only on explicit "Push branch & open PR"). Leave unset to disable.
# GITHUB_TOKEN=github_pat_...
# GITHUB_TOKEN_ENV=GITHUB_TOKEN

# Docker sandbox for executing repository tests (fails closed when Docker is unavailable)
SANDBOX_ENABLED=true
SANDBOX_PYTHON_IMAGE=python:3.11-slim

# AWS — "dump" (default) analyses a one-month export (fixtures/aws/* or an uploaded zip from
# scripts/export_aws_dump.sh); "live" uses read-only boto3 with the profile below.
AWS_MODE=dump
AWS_PROFILE=default
AWS_REGION=eu-west-2
AWS_REGION_ALLOWLIST=eu-west-2,eu-west-1,us-east-1
